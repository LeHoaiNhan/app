generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  customer
  admin
}

enum OrderStatus {
  submitted
  review
  sent
  approved
  delivered
  rejected
}

enum DocumentKind {
  applicant_photo
  passport_scan
  supporting
  visa_result
}

model User {
  id        String     @id @default(cuid())
  email     String     @unique
  name      String
  avatar    String?
  role      Role       @default(customer)
  googleId  String?    @unique
  password  String?
  createdAt DateTime   @default(now())
  orders    Order[]
  documents Document[]
}

model Order {
  id          String          @id
  customerId  String
  customer    User            @relation(fields: [customerId], references: [id])
  status      OrderStatus     @default(submitted)
  destination String
  flag        String?
  visaType    String
  processing  String
  fee         Json
  payment     Json
  applicant   Json
  passport    Json
  trip        Json
  timeline    TimelineEntry[]
  documents   Document[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([customerId])
  @@index([status])
}

model Document {
  id         String       @id @default(cuid())
  uploaderId String
  uploader   User         @relation(fields: [uploaderId], references: [id])
  orderId    String?
  order      Order?       @relation(fields: [orderId], references: [id], onDelete: SetNull)
  kind       DocumentKind @default(applicant_photo)
  filename   String
  url        String
  mimeType   String
  size       Int
  createdAt  DateTime     @default(now())

  @@index([uploaderId])
  @@index([orderId])
}

model TimelineEntry {
  id      String   @id @default(cuid())
  orderId String
  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  stage   String
  at      DateTime @default(now())
  note    String?

  @@index([orderId])
}
