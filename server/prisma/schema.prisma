generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
 
enum Role {
  customer
  admin
}

enum OrderStatus {
  submitted
  review
  sent
  approved
  delivered
  rejected
}

enum DocumentKind {
  applicant_photo
  passport_scan
  supporting
  visa_result
}

model User {
  id        String     @id @default(cuid())
  email     String     @unique
  name      String
  avatar    String?
  role      Role       @default(customer)
  googleId  String?    @unique
  password  String?
  createdAt DateTime   @default(now())
  orders    Order[]
  documents Document[]
  loginLogs LoginLog[]
}

enum LoginEvent {
  login_success
  login_failure
  logout
}

enum LoginProvider {
  google
  admin
}

model LoginLog {
  id        String        @id @default(cuid())
  userId    String?
  user      User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  email     String?
  event     LoginEvent
  provider  LoginProvider
  ip        String?
  userAgent String?
  reason    String?
  createdAt DateTime      @default(now())

  @@index([userId])
  @@index([createdAt])
  @@index([event])
}

model Order {
  id          String          @id
  customerId  String
  customer    User            @relation(fields: [customerId], references: [id])
  status      OrderStatus     @default(submitted)
  destination String
  flag        String?
  visaType    String
  processing  String
  fee         Json
  payment     Json
  applicant   Json
  passport    Json
  trip        Json
  timeline    TimelineEntry[]
  documents   Document[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([customerId])
  @@index([status])
}

model Document {
  id         String       @id @default(cuid())
  uploaderId String
  uploader   User         @relation(fields: [uploaderId], references: [id])
  orderId    String?
  order      Order?       @relation(fields: [orderId], references: [id], onDelete: SetNull)
  kind       DocumentKind @default(applicant_photo)
  filename   String
  url        String
  mimeType   String
  size       Int
  createdAt  DateTime     @default(now())

  @@index([uploaderId])
  @@index([orderId])
}

model TimelineEntry {
  id      String   @id @default(cuid())
  orderId String
  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  stage   String
  at      DateTime @default(now())
  note    String?

  @@index([orderId])
}

model ServiceTier {
  id             String   @id @default(cuid())
  key            String   @unique
  label          String
  fee            Int
  processingTime String
  description    String
  features       Json
  accent         String
  popular        Boolean  @default(false)
  active         Boolean  @default(true)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Country {
  id             String   @id @default(cuid())
  name           String   @unique
  flag           String
  iso            String
  region         String
  city           String
  tag            String
  govFee         Int?
  processingTime String
  maxStay        String
  entries        String
  validity       String
  description    String
  popular        Boolean  @default(false)
  trending       Boolean  @default(false)
  active         Boolean  @default(true)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([region])
  @@index([active])
}
