DATABASE_URL="postgresql://evisa:evisa@localhost:5432/evisa?schema=public"
JWT_SECRET="change-me-to-a-long-random-string"
PORT=4000
CORS_ORIGIN="http://localhost:5173"

ADMIN_EMAIL="admin@evisa.com"
ADMIN_PASSWORD="admin123"

# Optional — leave empty to use the demo /auth/google endpoint without verifying.
# In production, set this and the route will verify Google ID tokens.
GOOGLE_CLIENT_ID=""

# PayPal (sandbox by default). Get these from https://developer.paypal.com
# When empty, /payments/paypal/* will return 503 and the frontend hides the option.
PAYPAL_CLIENT_ID=""
PAYPAL_SECRET=""
PAYPAL_API_BASE="https://api-m.sandbox.paypal.com"
# For production: PAYPAL_API_BASE="https://api-m.paypal.com"
